# Rails backend used by the Nuxt API proxy in development and production.
NUXT_BACKEND_BASE_URL=http://localhost:8080

# Browser-facing API path. Keep this relative for same-origin cookie authentication.
NUXT_PUBLIC_API_BASE=/api

# Configure these on the BACKEND (not in this frontend env file):
# PUBLIC_BASE_URL=http://localhost:3000
# ADMIN_FRONTEND_URL=http://localhost:3000/admin
# GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# Register the exact callback URL in Google Cloud Console.
# Never put GOOGLE_CLIENT_SECRET or other backend secrets in NUXT_PUBLIC_*.
